<!DOCTYPE html>
<html>

<head>

    <title>Profile</title>

    <link rel="stylesheet" href="/style1.css">

</head>

<body class="auth-page">

    <div class="auth-container">

        <h1>My Profile</h1>

        <p>

            Name:
            <%= currentUser.name %>

        </p>

        <p>

            Email:
            <%= currentUser.email %>

        </p>

        <p>

            Role:
            <%= currentUser.role %>

        </p>

    </div>

</body>

</html>